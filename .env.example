# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/poki?schema=public"

# JWT
JWT_SECRET="replace-with-a-long-random-secret"

# AI Server (Pitchcoach-AI FastAPI)
AI_SERVER_URL="http://localhost:8000"
AI_INTERNAL_API_KEY="replace-with-same-key-as-ai-server"

# Google OAuth
GOOGLE_CLIENT_ID="replace-with-google-oauth-client-id"

# Server
PORT=3000
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

# AWS S3 (썸네일 이미지 저장)
S3_BUCKET_NAME="replace-with-bucket-name"
AWS_REGION="ap-northeast-2"
AWS_ACCESS_KEY_ID="replace-with-access-key"
AWS_SECRET_ACCESS_KEY="replace-with-secret-key"
S3_THUMBNAIL_PREFIX="thumbnails/"

# IR Deck 분석 타임아웃 (기본 15분)
# IR_DECK_ANALYSIS_TIMEOUT_MINUTES=15
# IR_DECK_SYNC_INTERVAL_MS=5000

# 음성 분석 타임아웃 (기본 10분)
# VOICE_ANALYSIS_TIMEOUT_MINUTES=10
